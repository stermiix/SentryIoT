%% Arquitetura do SentryIoT. Componentes descritos no ROADMAP.md e em codigo/mcp/README.md.
%% Regerar o PNG e o PDF: python -m artigo.figuras.diagramas arquitetura
%% Desenho mais alto que largo (06/11), para a letra sair no tamanho do texto; o detalhe fica na 3.5.
%%{init: {"theme": "neutral", "themeVariables": {"fontFamily": "Times New Roman, Times, serif", "fontSize": "15px"}, "flowchart": {"nodeSpacing": 18, "rankSpacing": 34, "wrappingWidth": 260}}}%%
flowchart TB
    subgraph deteccao["<b>Detecção</b>"]
        direction LR
        captura["<b>Captura</b><br/>tcpdump<br/>no gateway"] --> extrator["<b>Extrator</b><br/>39 features,<br/>janela de 100"]
        extrator --> rf["<b>Classificador</b><br/>Random Forest<br/>+ regra DDoS/DoS"]
    end

    orquestrador["<b>Orquestrador</b><br/>(código) chama os<br/>agentes e filtra os<br/>endereços do veredito"]
    mcp["<b>Servidor MCP</b><br/>11 tools por agente<br/>política de risco<br/>log de eventos<br/>ambiente simulado"]
    pessoa(["<b>Pessoa</b>, na interface<br/>vê o relatório,<br/>aprova o risco alto,<br/>marca 'já resolvido'"])

    subgraph local[" "]
        direction LR
        triagem["<b>Triagem</b><br/>lê o incidente,<br/>com os endereços"]
        decisao["<b>Decisão</b><br/>propõe a ação,<br/>só com rótulos"]
        execucao["<b>Execução</b><br/>aplica e verifica;<br/>única com<br/>credenciais"]
    end

    deteccao -- "abre o incidente" --> mcp
    orquestrador -- "agentes no <b>modelo local</b><br/>(qwen3.8-27c)" --> local
    mcp <--> triagem
    mcp <--> decisao
    mcp <--> execucao
    mcp -- "log" --> pessoa
    pessoa -- "aprovação" --> mcp
