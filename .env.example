# Provedor de LLM dos agentes e do chat da interface. Copie para .env (ignorado pelo git) e
# preencha. Nunca versione o .env nem cole a chave em commit, PR ou painel.
# LLM_BASE_URL é a base da API compatível com OpenAI, terminando em /v1 (ex.: https://provedor/v1).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Opcionais
# LLM_MODELOS_PERMITIDOS=outro-modelo,mais-um   (o LLM_MODEL entra sempre; sem a variável, só ele)
# LLM_CA_BUNDLE=/caminho/da/ca-interna.pem
# LLM_TIMEOUT_S=300
# Parâmetros de geração, mandados em toda chamada quando definidos (sem a variável, vale o padrão
# do provedor). Os valores abaixo são os medidos em 19/10 no gateway interno (qwen3.8-27c):
# LLM_RACIOCINIO=desligado     (ligado | desligado; vai em chat_template_kwargs.enable_thinking)
# LLM_TEMPERATURA=0
# LLM_SEMENTE=7
# LLM_MAX_TOKENS=2048
